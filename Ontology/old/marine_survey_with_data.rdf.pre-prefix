  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Act_AcquireDVLLock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Action"/>
    <rdfs:comment xml:lang="en">PDDL 'acquire_dvl_lock' - DVL bottom-lock, achievable only once the vehicle's altitude above the seabed is within dvl_range (depth-dependent) (domain_55.pddl).</rdfs:comment>
    <rdfs:label xml:lang="en">acquire_dvl_lock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Scenario">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Task"/>
    <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
    <rdfs:label xml:lang="en">Scenario</rdfs:label>
    <skos:definition xml:lang="en">The initial condition of a mission: platform and equipment state and the environment at mission start.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#MBES">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#BathymetricSensor"/>
    <rdfs:label xml:lang="en">Multibeam Echosounder</rdfs:label>
    <skos:altLabel xml:lang="en">Multibeam</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9fe667be0d344f47b7745d22025ae923">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
    <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
    <swrl:arguments rdf:nodeID="Nc9b4b7211ae4422d954b97c2dcdf6ff2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#BottomLocked">
