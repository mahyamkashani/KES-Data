        <rdfs:label>Stereo Camera</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Submersible_Vehicle -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Submersible_Vehicle">
