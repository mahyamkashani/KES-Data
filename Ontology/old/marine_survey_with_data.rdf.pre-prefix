  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#DataAcquisitionGoal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Goal"/>
    <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#QualificationGoal"/>
    <rdfs:label xml:lang="en">Data Acquisition Goal</rdfs:label>
    <skos:definition xml:lang="en">Acquire scientific data (e.g. seabed photo mosaics).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N962538e3dc744aab8fc061880de8e5e2">
