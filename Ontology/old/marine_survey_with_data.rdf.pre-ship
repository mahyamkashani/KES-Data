  <rdf:Description rdf:about="http://oru.se/marinellm/survey#CTDProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N978fcf1b8b264474a1770319c140c9bd"/>
