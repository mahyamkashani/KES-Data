  <rdf:Description rdf:about="http://oru.se/marinellm/survey#OpticalSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:label xml:lang="en">Optical Sensor</rdfs:label>
    <skos:definition xml:lang="en">A sensor imaging with light (camera, hyperspectral, ...).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Parasound">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Sonar"/>
    <rdfs:label xml:lang="en">Sub-bottom Profiler</rdfs:label>
    <skos:altLabel xml:lang="en">Parasound</skos:altLabel>
    <skos:altLabel xml:lang="en">Sub-bottom Profiler</skos:altLabel>
    <skos:definition xml:lang="en">Sediment-penetrating acoustic profiler (a sonar); PARASOUND is the GEOMAR instrument.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#AcousticMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N7d705a6a1a6e462d8f8ca48e766a07ba"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdfs:label xml:lang="en">Acoustic Mission</rdfs:label>
    <skos:definition xml:lang="en">A mission using an acoustic sensor (hydrophone, sonar, echosounder; Parasound counts via Sonar) on any of its vehicles (derived through usesDevice).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Act_Move">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Action"/>
    <rdfs:comment xml:lang="en">PDDL durative-action 'move' - transit between connected waypoints; the destination's terrain class (flat/rocky) is read from the ontology, and rocky ground requires a live DVL bottom-lock or USBL fix (domain_55.pddl).</rdfs:comment>
    <rdfs:label xml:lang="en">move</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc8fe86f392834ee6a00bc005ddb8eba6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
    <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Task"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na5c0ce289f814060a7af53f845c3a76f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasDestination"/>
    <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#UnconstrainedSite"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#BottomLocked">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N84a84e10fe5b49c9b1862a922f7c94a4"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
    <rdfs:label xml:lang="en">Bottom-Locked AUV</rdfs:label>
    <skos:definition xml:lang="en">AUV currently holding a DVL bottom-lock specifically -- a ship-relative USBL fix cannot track altitude over a scarp.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#SurveyNavigation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/ssn/Deployment"/>
    <rdfs:subClassOf rdf:nodeID="N31892e6d6dea494fa43b08bf7608cd6a"/>
    <rdfs:label xml:lang="en">Survey and Navigation</rdfs:label>
    <skos:altLabel xml:lang="en">Survey and Navigation</skos:altLabel>
    <skos:definition xml:lang="en">A survey campaign and its navigation, grouping the observation and sampling activities carried out from a platform. A cruise report typically contains several missions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#missionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#SurveyNavigation"/>
    <rdfs:label xml:lang="en">mission of</rdfs:label>
    <skos:definition xml:lang="en">Derived: the survey campaign (SurveyNavigation) a mission belongs to -- the inverse of hasMission.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nce9146aa27014e1b83d6331b41ac0d45">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#requiresNavigation"/>
    <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#NavFixRequired"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Camera">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#OpticalSensor"/>
    <rdfs:label xml:lang="en">Camera</rdfs:label>
    <skos:altLabel xml:lang="en">CoraMo</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#NavFixRequired">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#NavigationRequirement"/>
    <rdfs:label xml:lang="en">navigation fix required</rdfs:label>
    <skos:definition xml:lang="en">Hard/irregular ground: needs a LIVE fix -- DVL bottom-lock OR USBL. Either satisfies it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf528e94397b141fe98cf9ba11ba4cc48">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
