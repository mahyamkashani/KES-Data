  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Manipulator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
    <rdfs:label xml:lang="en">Manipulator Arm</rdfs:label>
    <skos:altLabel xml:lang="en">ORION</skos:altLabel>
    <skos:altLabel xml:lang="en">RIGMASTER</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#DataSamplingMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab119"/>
    <rdfs:label xml:lang="en">Data Sampling Mission</rdfs:label>
    <skos:definition xml:lang="en">A mission carrying out a data-sampling activity (derived through hasActivity).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab115">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab117"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab107">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab109"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#DVL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:label xml:lang="en">Doppler Velocity Log</rdfs:label>
    <skos:definition xml:lang="en">Bottom-lock sensor; locks only within dvl_range of the seabed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab167">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab183"/>
  </rdf:Description>
