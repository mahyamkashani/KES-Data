>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab70">
    <rdf:first rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab68"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab50">
    <rdf:first rdf:resource="http://oru.se/marinellm/survey#Submersible"/>
    <rdf:rest rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab51"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#PlannableMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab94"/>
    <rdfs:label xml:lang="en">Plannable Mission</rdfs:label>
    <skos:definition xml:lang="en">A mission whose tasks are grounded in PDDL action schemas, so a problem file can be generated.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab52">
    <rdf:first rdf:resource="http://oru.se/marinellm/survey#Transponder"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#NavFixSite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab133"/>
    <rdfs:label xml:lang="en">Navigation-Fix Site</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab150">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasSensor"/>
    <owl:someValuesFrom rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab151"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#HasUSBLFix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
    <rdfs:label xml:lang="en">AUV currently holding a USBL fix</rdfs:label>
    <skos:definition xml:lang="en">FLUENT: the planner asserts/retracts this as the USBL fix is (re)acquired or lost.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#FullySuccessfulMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab42"/>
    <rdfs:label xml:lang="en">Fully Successful Mission</rdfs:label>
    <skos:definition xml:lang="en">A mission that has tasks and all of them succeeded.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#inMission"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdfs:label xml:lang="en">has activity</rdfs:label>
    <skos:definition xml:lang="en">Derived: the survey activities (observations, samplings) carried out under a mission -- the inverse of inMission (usedProcedure o taskOf).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab120">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasActivity"/>
    <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#DataSampling"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#BathymetricSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:subClassOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab4"/>
    <rdfs:label xml:lang="en">Bathymetric Sensor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#TrialMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab84"/>
    <rdfs:label xml:lang="en">Trial Mission</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab96">
    <rdf:first rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdf:rest rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab97"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab135">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasSurface"/>
    <owl:someValuesFrom rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab136"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab39">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasStatus"/>
    <owl:hasValue>FAILED</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#SinglePlatformMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab77"/>
    <rdfs:label xml:lang="en">Single-Platform Mission</rdfs:label>
    <skos:definition xml:lang="en">A mission using exactly one vehicle.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/madeBySensor"/>
    <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#BathymetricSensor"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab145">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab147"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#DataSampling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    <rdfs:subClassOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab14"/>
    <rdfs:subClassOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab15"/>
    <rdfs:label xml:lang="en">Data Sampling</rdfs:label>
    <skos:altLabel xml:lang="en">Data Sampling</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab97">
    <rdf:first rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab95"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
    <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#Depth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Act_TakePhoto">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Action"/>
    <rdfs:label xml:lang="en">take_photo</rdfs:label>
    <rdfs:comment xml:lang="en">PDDL 'take_photo' - CoraMo Mk II imaging survey flown at the seabed under DVL bottom-lock, producing one photo survey per site (domain_55.pddl).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Transponder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
    <rdfs:label xml:lang="en">Seabed Transponder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab43">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasTask"/>
    <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Task"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab59">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab61"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#BottomLocked">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab162"/>
    <rdfs:label xml:lang="en">Bottom-Locked AUV</rdfs:label>
    <skos:definition xml:lang="en">AUV currently holding a DVL bottom-lock specifically -- a ship-relative USBL fix cannot track altitude over a scarp.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab47">
    <rdf:first rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab43"/>
    <rdf:rest rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab48"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#realisedByAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Action"/>
    <rdfs:label xml:lang="en">realised by action</rdfs:label>
    <skos:definition xml:lang="en">Links a mission Task to the primitive planner Action(s) that carry it out (PDDL domain al533_auv_survey, domain_55.pddl).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab82">
    <rdf:first rdf:resource="http://oru.se/marinellm/survey#QualificationGoal"/>
    <rdf:rest rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab83"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#BottomLockSite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab139"/>
    <rdfs:label xml:lang="en">Bottom-Lock Site</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab171">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasDestination"/>
