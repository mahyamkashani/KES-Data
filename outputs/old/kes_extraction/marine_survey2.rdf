  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab67">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab69"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#LongTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Task"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab30"/>
    <rdfs:label xml:lang="en">Long Task</rdfs:label>
    <skos:definition xml:lang="en">A task of 6 h or more -- about one hover-AUV battery endurance (Rep55 Sec. 5.2.1, ~8 h).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab156">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab160"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#BathymetricObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:subClassOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab1"/>
    <rdfs:subClassOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab2"/>
    <rdfs:subClassOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab3"/>
    <rdfs:label xml:lang="en">Bathymetric Observation</rdfs:label>
    <skos:altLabel xml:lang="en">Bathymetric</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#sand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
    <rdfs:label xml:lang="en">sand</rdfs:label>
    <rdfs:comment xml:lang="en">Sandy / overgrown sediment; benign but poor optical contrast (Rep57 p.88, Gozo).</rdfs:comment>
    <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#NoFixRequired"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#NoFixRequired">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#NavigationRequirement"/>
    <rdfs:label xml:lang="en">no navigation fix required</rdfs:label>
    <skos:definition xml:lang="en">Benign ground: traversable dead-reckoned, no live fix needed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab72">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesVehicle"/>
    <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Submersible"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasDuration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">has duration</rdfs:label>
    <skos:definition xml:lang="en">Task duration in decimal hours. Omitted when unknown (open-world), never written as 0. Mission duration = sum over tasks, computed in SPARQL (no arithmetic in OWL).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#ImagingMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab98"/>
    <rdfs:label xml:lang="en">Imaging Mission</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:propertyChainAxiom rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab92"/>
    <rdfs:label xml:lang="en">has action</rdfs:label>
    <skos:definition xml:lang="en">Derived: the primitive planner actions of a mission, via its tasks.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Camera">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#OpticalSensor"/>
    <rdfs:label xml:lang="en">Camera</rdfs:label>
    <skos:altLabel xml:lang="en">CoraMo</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#initialConditionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#hasInitialCondition"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Scenario"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdfs:label xml:lang="en">initial condition of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#PerformableTraversal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Traversal"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab167"/>
    <rdfs:label xml:lang="en">Performable Traversal</rdfs:label>
    <skos:definition xml:lang="en">A traversal the vehicle can actually perform: the destination is unconstrained, OR needs a nav-fix and the vehicle has one, OR needs bottom-lock and the vehicle has it. The whole of can_perform as one OWL concept (README Sec. 7.2).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab37">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab40"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab68">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesVehicle"/>
    <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Transponder"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab103">
    <rdf:first rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdf:rest rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab104"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Act_DeepDive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Action"/>
    <rdfs:label xml:lang="en">deep_dive</rdfs:label>
    <rdfs:comment xml:lang="en">PDDL 'deep_dive' - USBL-aided descent through the water column to the site's seabed depth (no DVL bottom-lock yet) (domain_55.pddl).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#seabedDepth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">seabed depth</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#rocky">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
    <rdfs:label xml:lang="en">rocky</rdfs:label>
    <rdfs:comment xml:lang="en">Stony / hard ground, pillow lava (Rep55 Lipari, Vulcano; Rep57 high-backscatter shelf).</rdfs:comment>
    <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#NavFixRequired"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#HasDVLLock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
    <rdfs:label xml:lang="en">AUV currently holding DVL bottom-lock</rdfs:label>
    <skos:definition xml:lang="en">FLUENT: the planner asserts/retracts this as the DVL locks or drops.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Action">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
    <rdfs:label xml:lang="en">Action</rdfs:label>
    <skos:definition xml:lang="en">A primitive, executable vehicle operation - a durative-action schema in the PDDL planning domain (domain_55.pddl). Tasks are realised by sequences of Actions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab121">
    <rdf:first rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdf:rest rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab122"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#steep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
    <rdfs:label xml:lang="en">steep</rdfs:label>
    <rdfs:comment xml:lang="en">Slope / scarp. Altitude changes fast under the vehicle, so a ship-relative USBL fix is not enough -- DVL bottom-lock is mandatory.</rdfs:comment>
    <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#BottomLockRequired"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#DataSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
    <rdfs:label xml:lang="en">Data Sample</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab30">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab35"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#CTDMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab115"/>
    <rdfs:label xml:lang="en">CTD Mission</rdfs:label>
    <skos:definition xml:lang="en">A mission carrying out a CTD-profile activity (derived through hasActivity).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab101">
    <rdf:first rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab99"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#NavFixCapable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
    <owl:equivalentClass rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab149"/>
    <rdfs:label xml:lang="en">Navigation-Fix Capable Vehicle</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasDestination">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Traversal"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
    <rdfs:label xml:lang="en">has destination</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Echosounder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#BathymetricSensor"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AcousticSensor"/>
    <rdfs:label xml:lang="en">Echosounder</rdfs:label>
    <skos:definition xml:lang="en">Acoustic depth sounder (single- or split-beam); both a bathymetric and an acoustic sensor.</skos:definition>
    <skos:altLabel xml:lang="en">Echosounder</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab65">
