    <rdfs:label xml:lang="en">flat</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#PlannableMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N70107f4c43b44d08a248d8043c7b10b5"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdfs:label xml:lang="en">Plannable Mission</rdfs:label>
    <skos:definition xml:lang="en">A mission whose tasks are grounded in PDDL action schemas, so a problem file can be generated.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#NavFixed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N402b3e8e8d5440e6a065abe36b0459aa"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
    <rdfs:label xml:lang="en">Navigation-Fixed AUV</rdfs:label>
    <skos:definition xml:lang="en">AUV currently holding EITHER a DVL bottom-lock or a USBL fix -- either suffices for a nav-fix site.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1959d22742094ffcbe17ba3a67be9db7">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="N4ed6b58653cb453a9df070879a909d47"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#inMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <owl:propertyChainAxiom rdf:nodeID="Nebdd2519764e41c293c74fc41f8f3086"/>
    <rdfs:label xml:lang="en">in mission</rdfs:label>
    <skos:definition xml:lang="en">Derived: the mission an observation or sampling activity belongs to, via the task it executes (usedProcedure o taskOf).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne2e108d1642e4fab9f7eef71c6ea3dc4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasAction"/>
    <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Action"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7e871a43fa2f41e2bd90a76781f7899a">
    <rdf:first rdf:resource="http://oru.se/marinellm/survey#HasDVLLock"/>
