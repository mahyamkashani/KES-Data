        <rdfs:label xml:lang="en">Depth</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#JAGO -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#JAGO">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Submersible"/>
        <hasSensor rdf:resource="http://oru.se/marinellm/survey#ANTON"/>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#LUISE -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#LUISE">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <hasSensor rdf:resource="http://oru.se/marinellm/survey#CoraMo_MK_II"/>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#Mission_AL533 -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#Mission_AL533">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <usesVehicle rdf:resource="http://oru.se/marinellm/survey#ANTON"/>
        <usesVehicle rdf:resource="http://oru.se/marinellm/survey#JAGO"/>
        <usesVehicle rdf:resource="http://oru.se/marinellm/survey#LUISE"/>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#NavFixRequired -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#NavFixRequired">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#NavigationRequirement"/>
        <rdfs:label xml:lang="en">navigation fix required</rdfs:label>
        <skos:definition xml:lang="en">Hard/irregular ground: needs a LIVE fix -- DVL bottom-lock OR USBL. Either satisfies it.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#NoFixRequired -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#NoFixRequired">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#NavigationRequirement"/>
        <rdfs:label xml:lang="en">no navigation fix required</rdfs:label>
        <skos:definition xml:lang="en">Benign ground: traversable dead-reckoned, no live fix needed.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#Temperature -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#Temperature">
        <rdf:type rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:label xml:lang="en">Temperature</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#flat -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#flat">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
        <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#NoFixRequired"/>
        <rdfs:comment xml:lang="en">Level soft sediment (Rep57 Sec.5.1: soft-sediment basin).</rdfs:comment>
        <rdfs:label xml:lang="en">flat</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#rocky -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#rocky">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
        <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#NavFixRequired"/>
        <rdfs:comment xml:lang="en">Stony / hard ground, pillow lava (Rep55 Lipari, Vulcano; Rep57 high-backscatter shelf).</rdfs:comment>
        <rdfs:label xml:lang="en">rocky</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#sand -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#sand">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
        <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#NoFixRequired"/>
        <rdfs:comment xml:lang="en">Sandy / overgrown sediment; benign but poor optical contrast (Rep57 p.88, Gozo).</rdfs:comment>
        <rdfs:label xml:lang="en">sand</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#steep -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#steep">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
        <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#BottomLockRequired"/>
        <rdfs:comment xml:lang="en">Slope / scarp. Altitude changes fast under the vehicle, so a ship-relative USBL fix is not enough -- DVL bottom-lock is mandatory.</rdfs:comment>
        <rdfs:label xml:lang="en">steep</rdfs:label>
    </owl:NamedIndividual>
