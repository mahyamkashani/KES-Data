<?xml version="1.0"?>
<rdf:RDF xmlns="http://oru.se/marinellm/survey#"
     xml:base="http://oru.se/marinellm/survey"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:core="http://www.w3.org/2004/02/skos/core#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#">
    <owl:Ontology rdf:about="http://oru.se/marinellm/survey">
        <owl:versionIRI rdf:resource="http://oru.se/marinellm/survey"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/ns/sosa/resultTime -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/sosa/resultTime"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://oru.se/marinellm/survey#before -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#before">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#goes_through -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#goes_through">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Traversal"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasAction -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasAction">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasTask"/>
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#realisedByAction"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">has action</rdfs:label>
        <core:definition xml:lang="en">Derived: the primitive planner actions of a mission, via its tasks.</core:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasDestination -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasDestination">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Traversal"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:label xml:lang="en">has destination</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasGoal -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasGoal">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">has goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasInitialCondition -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasInitialCondition">
        <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#initialConditionOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has initial condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasMission -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasMission">
        <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#missionOf"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">has mission</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasScenarioTask -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasScenarioTask">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#initialConditionOf"/>
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasTask"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">has scenario task</rdfs:label>
        <core:definition xml:lang="en">Derived: the tasks carried out under this scenario -- the tasks of the (single) mission this scenario initiates (initialConditionOf o hasTask).</core:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasSensor -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasSensor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Ship"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:label xml:lang="en">has sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasSurface -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasSurface">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Terrain"/>
        <rdfs:label xml:lang="en">has surface</rdfs:label>
        <core:definition xml:lang="en">The ground class of a terrain area. Functional: one area has exactly one surface.</core:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasTask -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasTask">
        <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#taskOf"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:label xml:lang="en">has task</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasVehicle -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasVehicle">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Traversal"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">has vehicle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#has_Terrain -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#has_Terrain">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#State"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Terrain"/>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#initialConditionOf -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#initialConditionOf">
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <rdfs:label xml:lang="en">initial condition of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#missionOf -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#missionOf">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">mission of</rdfs:label>
        <core:definition xml:lang="en">Derived: the survey campaign (SurveyNavigation) a mission belongs to -- the inverse of hasMission.</core:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#onTerrain -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#onTerrain">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Terrain"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#State"/>
        <rdfs:label xml:lang="en">on terrain</rdfs:label>
        <core:definition xml:lang="en">The terrain AREA a waypoint falls inside. Terrain is a mappable area covering a SET of waypoints, not a per-waypoint tag.</core:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#realisedByAction -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#realisedByAction">
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <rdfs:label xml:lang="en">realised by action</rdfs:label>
        <core:definition xml:lang="en">Links a mission Task to the primitive planner Action(s) that carry it out (PDDL domain al533_auv_survey, domain_55.pddl).</core:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#requiresNavigation -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#requiresNavigation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Terrain"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:label xml:lang="en">requires navigation</rdfs:label>
        <core:definition xml:lang="en">THE RULE: the navigation capability a vehicle must hold to traverse this surface. This is the ontology half of can_perform.</core:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#taskOf -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#taskOf">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <rdfs:label xml:lang="en">task of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#usesDevice -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#usesDevice">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">uses device</rdfs:label>
        <core:definition xml:lang="en">Derived: the devices a mission uses, via the vehicles it uses (usesVehicle o hasDevice). Never asserted.</core:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#usesVehicle -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#usesVehicle">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">uses vehicle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasResult -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasResult"/>
    


    <!-- http://www.w3.org/ns/sosa/madeBySensor -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySensor"/>
    


    <!-- http://www.w3.org/ns/sosa/observedProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observedProperty"/>
    


    <!-- http://www.w3.org/ns/sosa/observes -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observes"/>
    


    <!-- http://www.w3.org/ns/sosa/usedProcedure -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/usedProcedure"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://oru.se/marinellm/survey#MissionID -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#MissionID">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">mission ID</rdfs:label>
        <core:definition xml:lang="en">Cruise or mission identifier used by the operator (&quot;AL533&quot;).</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#collect_sample -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#collect_sample">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Data_Sampling_Mission"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#dataVolume -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#dataVolume">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">data volume</rdfs:label>
        <core:definition xml:lang="en">Amount of data the mission produced, verbatim from the report including its unit.</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#endTime -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#endTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">end time</rdfs:label>
        <core:definition xml:lang="en">When the mission ended, verbatim from the report (&quot;2020-02-18&quot;).</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#hasDuration -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#hasDuration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">has duration</rdfs:label>
        <core:definition xml:lang="en">Task duration in decimal hours. Omitted when unknown (open-world), never written as 0. Mission duration = sum over tasks, computed in SPARQL (no arithmetic in OWL). Reports that give a duration with its unit or as a span go to hasDurationText.</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#hasDurationText -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#hasDurationText">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has duration (as reported)</rdfs:label>
        <core:definition xml:lang="en">Duration verbatim from the source report, keeping the unit the report used (&quot;11.5 days&quot;). Companion to hasDuration, which holds decimal hours.</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#hasStatus -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#hasStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>FAILED</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>PartialFAILURE</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>PartialSUCCESSFUL</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>SUCCESSFUL</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">has status</rdfs:label>
        <core:definition xml:lang="en">The outcome of a task: exactly one of SUCCESSFUL / PartialSUCCESSFUL / FAILED (closed datatype enumeration). Functional: one status per task.</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#has_Conductivity -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#has_Conductivity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#State"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#has_Depth -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#has_Depth">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#State"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#has_Maximum_Depth -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#has_Maximum_Depth">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#has_Temperature -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#has_Temperature">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#State"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#latitude -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#latitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">latitude</rdfs:label>
        <core:definition xml:lang="en">Latitude as printed in the cruise report, degrees and decimal minutes with a hemisphere letter (&quot;38°24.70&apos;N&quot;). String rather than decimal because the reports do not use signed decimal degrees.</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#locationName -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#locationName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">location name</rdfs:label>
        <core:definition xml:lang="en">Place name the report uses for the waypoint -- an island, bank, seamount or station area (&quot;Vulcano&quot;, &quot;Lipari&quot;).</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#longitude -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#longitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">longitude</rdfs:label>
        <core:definition xml:lang="en">Longitude as printed in the cruise report, degrees and decimal minutes with a hemisphere letter (&quot;14°58.56&apos;E&quot;).</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#maxDepth -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#maxDepth">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">max depth</rdfs:label>
        <core:definition xml:lang="en">Deepest point reached during the mission, in metres. Numeric; an extraction carrying a unit or a range goes to maxDepthText.</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#maxDepthText -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#maxDepthText">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">max depth (as reported)</rdfs:label>
        <core:definition xml:lang="en">Maximum mission depth verbatim from the report, keeping ranges and units. Companion to maxDepth.</core:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#remark -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#remark">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">remark</rdfs:label>
