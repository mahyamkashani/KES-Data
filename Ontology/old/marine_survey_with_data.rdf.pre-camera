  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Task">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
    <rdfs:subClassOf rdf:nodeID="N8f3db7c3200949ec87f5603eb77c6abd"/>
    <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
    <rdfs:label xml:lang="en">Task</rdfs:label>
    <skos:definition xml:lang="en">An operation carried out as part of a mission (e.g. a dive, a deployment, a test).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5b0cd9fc2a1746c2a61bb3c45eb23350">
    <rdf:first rdf:nodeID="Ne881c2bdf8c24f69bcb594263b7faa13"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#requiresNavigation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Surface"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#NavigationRequirement"/>
    <rdfs:label xml:lang="en">requires navigation</rdfs:label>
    <skos:definition xml:lang="en">THE RULE: the navigation capability a vehicle must hold to traverse this surface. This is the ontology half of can_perform.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#NavFixed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N0037571681f846fcb45df45548386776"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
    <rdfs:label xml:lang="en">Navigation-Fixed AUV</rdfs:label>
    <skos:definition xml:lang="en">AUV currently holding EITHER a DVL bottom-lock or a USBL fix -- either suffices for a nav-fix site.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne40d5b679a7744a99ac2a20e6780f41a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="N4037d00947e8406b8f2617f2428e8e06"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Scenario">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Task"/>
    <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
    <rdfs:label xml:lang="en">Scenario</rdfs:label>
    <skos:definition xml:lang="en">The initial condition of a mission: platform and equipment state and the environment at mission start.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Traversal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N9dba7fbeaf0f4e29aa0c53b127cf8007"/>
    <rdfs:subClassOf rdf:nodeID="Nf3b02ce5e80b4ed9b0d963fe92dafc4a"/>
    <rdfs:label xml:lang="en">Traversal</rdfs:label>
    <skos:definition xml:lang="en">A reified move: an AUV going to a destination waypoint.</skos:definition>
  </rdf:Description>
