"""
Usage:  python populate_ontology.py [axioms.json] [--source=tbox.rdf] [--target=out.rdf]
"""
import json
import os
import re
import sys

KES = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, KES)

import ontology_importer
import Creator_ontology_Individual_Creator as IndividualCreator
import Creator_ontology_Property_Creator as PropertyCreator

HERE = os.path.dirname(os.path.abspath(__file__))

#--source/--target let the same script populate any T-box, not just marine_survey2
_args = [a for a in sys.argv[1:] if not a.startswith("--")]
_opts = dict(a[2:].split("=", 1) for a in sys.argv[1:] if a.startswith("--") and "=" in a)
SOURCE = os.path.abspath(_opts.get("source", os.path.join(HERE, "marine_survey_with_data.rdf")))
TARGET = os.path.abspath(_opts.get("target", os.path.join(HERE, "marine_survey_populated.rdf")))
AXIOMS = _args[0] if _args else os.path.join(
    HERE, "outputs", "output_binary_geomar_rep_ns_55_2020-highlight.json")

# Axioms judged incorrect on review; listed as "<individual1> <property> <individual2>".
# The extraction asserted JAGO hasDevice ANTON/LUISE, but the cruise report describes
# ANTON and LUISE as independent hover-AUVs, not devices carried by JAGO.
# Add entries here to keep them out of the populated ontology.
EXCLUDE = set()


def sanitise(name):
    """owlready2 resolves individuals via getattr, so names need to be identifiers."""
    return re.sub(r"\W+", "_", name.strip()).strip("_")


def main():
    with open(AXIOMS) as fh:
        axioms = json.load(fh)["ObjectPropertyAxiom"]

    #owlready2 fetches owl:imports over the web unless onto_path holds a local
    #copy named after the import IRI (ssn.rdf, sosa.rdf next to the T-box).
    from owlready2 import onto_path
    for d in (os.path.dirname(SOURCE), HERE, KES):
        if d and d not in onto_path:
            onto_path.append(d)

    onto = ontology_importer.ontology_reader("file://" + SOURCE)
    before = len(list(onto.individuals()))

    created, asserted, skipped = [], [], []

    for axiom in axioms:
        subject_raw, object_raw = axiom["INDIVIDUAL"]
        prop = axiom["OBJECT_PROPERTY"]

        if f"{subject_raw} {prop} {object_raw}" in EXCLUDE:
            skipped.append(axiom["AXIOM"])
            continue

        #the model sometimes returns a class name in the individual slot
        #("JAGO hasSensor USBL"). Asserting that would create an individual
        #named USBL of class USBL, so drop it rather than pollute the A-box.
        if sanitise(subject_raw) == axiom["DOMAIN"] or sanitise(object_raw) == axiom["RANGE"]:
            skipped.append(axiom["AXIOM"] + "   [class name in individual slot]")
            continue

        pairs = ((sanitise(subject_raw), axiom["DOMAIN"]), (sanitise(object_raw), axiom["RANGE"]))
        for individual_name, class_name in pairs:
            if getattr(onto, class_name, None) is None:
                raise ValueError(f"class {class_name!r} not in ontology")
            # Re-running must not duplicate individuals already asserted.
            if getattr(onto, individual_name, None) is None:
                IndividualCreator.createIndividual(onto, class_name, individual_name)
                created.append(f"{individual_name} : {class_name}")

        PropertyCreator.createObjPropertyForIndividual(
            onto, prop, sanitise(subject_raw), sanitise(object_raw)
        )
        asserted.append(axiom["AXIOM"])

    onto.save(file=TARGET, format="rdfxml")

    print(f"individuals before: {before}  after: {len(list(onto.individuals()))}")
    print(f"\ncreated {len(created)} individuals:")
    for entry in created:
        print(f"  + {entry}")
    print(f"\nasserted {len(asserted)} axioms:")
    for entry in asserted:
        print(f"  + {entry}")
    if skipped:
        print(f"\nskipped {len(skipped)} excluded axioms:")
        for entry in skipped:
            print(f"  - {entry}")
    print(f"\nwritten to {TARGET}")


if __name__ == "__main__":
    main()
