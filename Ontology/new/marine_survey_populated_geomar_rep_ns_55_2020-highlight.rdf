    <owl:Class rdf:about="http://oru.se/marinellm/survey#Station">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:label>Station</rdfs:label>
    </owl:Class>
    


