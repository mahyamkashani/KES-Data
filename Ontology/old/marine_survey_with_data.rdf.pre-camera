  <rdf:Description rdf:about="http://oru.se/marinellm/survey#NavFixRequired">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#NavigationRequirement"/>
    <rdfs:label xml:lang="en">navigation fix required</rdfs:label>
    <skos:definition xml:lang="en">Hard/irregular ground: needs a LIVE fix -- DVL bottom-lock OR USBL. Either satisfies it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N57da330060b64f959f49fd253d7c0892">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <owl:withRestrictions rdf:nodeID="N590cab095a3f4d15968a7dc13c6d5d4f"/>
  </rdf:Description>
