<?xml version="1.0"?>
<rdf:RDF xmlns="http://oru.se/marinellm/survey#"
     xml:base="http://oru.se/marinellm/survey"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="http://oru.se/marinellm/survey">
        <owl:imports rdf:resource="http://www.w3.org/ns/ssn/"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/ns/sosa/resultTime -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/sosa/resultTime"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://oru.se/marinellm/survey#deployedFromShip -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#deployedFromShip">
        <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#deploysVehicle"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Ship"/>
        <rdfs:label xml:lang="en">deployed from ship</rdfs:label>
        <skos:definition xml:lang="en">Links a vehicle to the mother ship it is launched and recovered from.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#deploysVehicle -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#deploysVehicle">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Ship"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">deploys vehicle</rdfs:label>
        <skos:definition xml:lang="en">Links the mother ship to a vehicle launched and recovered from it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasAction -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasAction">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasTask"/>
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#realisedByAction"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">has action</rdfs:label>
        <skos:definition xml:lang="en">Derived: the primitive planner actions of a mission, via its tasks.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasActivity -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasActivity">
        <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#inMission"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">has activity</rdfs:label>
        <skos:definition xml:lang="en">Derived: the survey activities (observations, samplings) carried out under a mission -- the inverse of inMission (usedProcedure o taskOf).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasDestination -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasDestination">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Traversal"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:label xml:lang="en">has destination</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasDevice -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasDevice">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Device"/>
        <rdfs:label xml:lang="en">has device</rdfs:label>
        <skos:definition xml:lang="en">A device (sensor or actuator) fitted to a vehicle. Populated from Q7 by csv2onto.py.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasGoal -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasGoal">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Goal"/>
        <rdfs:label xml:lang="en">has goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasInitialCondition -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasInitialCondition">
        <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#initialConditionOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Scenario"/>
        <rdfs:label xml:lang="en">has initial condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasMission -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasMission">
        <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#missionOf"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">has mission</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasScenarioTask -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasScenarioTask">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Scenario"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#initialConditionOf"/>
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasTask"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">has scenario task</rdfs:label>
        <skos:definition xml:lang="en">Derived: the tasks carried out under this scenario -- the tasks of the (single) mission this scenario initiates (initialConditionOf o hasTask).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasSensor -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasSensor">
        <rdfs:subPropertyOf rdf:resource="http://oru.se/marinellm/survey#hasDevice"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:label xml:lang="en">has sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasSurface -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasSurface">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#TerrainArea"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Surface"/>
        <rdfs:label xml:lang="en">has surface</rdfs:label>
        <skos:definition xml:lang="en">The ground class of a terrain area. Functional: one area has exactly one surface.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasTask -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasTask">
        <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#taskOf"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:label xml:lang="en">has task</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#hasVehicle -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#hasVehicle">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Traversal"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#AUV"/>
        <rdfs:label xml:lang="en">has vehicle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#inMission -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#inMission">
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/usedProcedure"/>
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#taskOf"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">in mission</rdfs:label>
        <skos:definition xml:lang="en">Derived: the mission an observation or sampling activity belongs to, via the task it executes (usedProcedure o taskOf).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#initialConditionOf -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#initialConditionOf">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Scenario"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">initial condition of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#missionOf -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#missionOf">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">mission of</rdfs:label>
        <skos:definition xml:lang="en">Derived: the survey campaign (SurveyNavigation) a mission belongs to -- the inverse of hasMission.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#onTerrain -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#onTerrain">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#TerrainArea"/>
        <rdfs:label xml:lang="en">on terrain</rdfs:label>
        <skos:definition xml:lang="en">The terrain AREA a waypoint falls inside. Terrain is a mappable area covering a SET of waypoints, not a per-waypoint tag.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#operatedFromShip -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#operatedFromShip">
        <owl:inverseOf rdf:resource="http://oru.se/marinellm/survey#supportsMission"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Ship"/>
        <rdfs:label xml:lang="en">operated from ship</rdfs:label>
        <skos:definition xml:lang="en">Links a mission to the ship it was run from.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#realisedByAction -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#realisedByAction">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <rdfs:label xml:lang="en">realised by action</rdfs:label>
        <skos:definition xml:lang="en">Links a mission Task to the primitive planner Action(s) that carry it out (PDDL domain al533_auv_survey, domain_55.pddl).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#requiresNavigation -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#requiresNavigation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Surface"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#NavigationRequirement"/>
        <rdfs:label xml:lang="en">requires navigation</rdfs:label>
        <skos:definition xml:lang="en">THE RULE: the navigation capability a vehicle must hold to traverse this surface. This is the ontology half of can_perform.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#supportsMission -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#supportsMission">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Ship"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">supports mission</rdfs:label>
        <skos:definition xml:lang="en">Links a ship to a mission run from it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#taskOf -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#taskOf">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">task of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#usesDevice -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#usesDevice">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#usesVehicle"/>
            <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasDevice"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">uses device</rdfs:label>
        <skos:definition xml:lang="en">Derived: the devices a mission uses, via the vehicles it uses (usesVehicle o hasDevice). Never asserted.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://oru.se/marinellm/survey#usesVehicle -->

    <owl:ObjectProperty rdf:about="http://oru.se/marinellm/survey#usesVehicle">
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">uses vehicle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://oru.se/marinellm/survey#hasDuration -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#hasDuration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">has duration</rdfs:label>
        <skos:definition xml:lang="en">Task duration in decimal hours. Omitted when unknown (open-world), never written as 0. Mission duration = sum over tasks, computed in SPARQL (no arithmetic in OWL).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#hasStatus -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#hasStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>FAILED</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>PartialSUCCESSFUL</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>SUCCESSFUL</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">has status</rdfs:label>
        <skos:definition xml:lang="en">The outcome of a task: exactly one of SUCCESSFUL / PartialSUCCESSFUL / FAILED (closed datatype enumeration). Functional: one status per task.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://oru.se/marinellm/survey#seabedDepth -->

    <owl:DatatypeProperty rdf:about="http://oru.se/marinellm/survey#seabedDepth">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">seabed depth</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://oru.se/marinellm/survey#ADCP -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#ADCP">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:label xml:lang="en">Acoustic Doppler Current Profiler</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#AUV -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#AUV">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Submersible"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Transponder"/>
        <rdfs:label xml:lang="en">Autonomous Underwater Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#AUVMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#AUVMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesVehicle"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#AUV"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">AUV Mission</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#AcousticMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#AcousticMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesDevice"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#AcousticSensor"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Acoustic Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission using an acoustic sensor (hydrophone, sonar, echosounder; Parasound counts via Sonar) on any of its vehicles (derived through usesDevice).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#AcousticSensor -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#AcousticSensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:label xml:lang="en">Acoustic Sensor</rdfs:label>
        <skos:definition xml:lang="en">A sensor operating with sound (hydrophone, sonar, echosounder, sub-bottom profiler). Note: USBL/ADCP/DVL are acoustic too but are positioning/current instruments, deliberately NOT grouped here.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Action -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Action">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:label xml:lang="en">Action</rdfs:label>
        <skos:definition xml:lang="en">A primitive, executable vehicle operation - a durative-action schema in the PDDL planning domain (domain_55.pddl). Tasks are realised by sequences of Actions.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#BathymetricObservation -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#BathymetricObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/madeBySensor"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#BathymetricSensor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
                <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#Depth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Bathymetric Observation</rdfs:label>
        <skos:altLabel xml:lang="en">Bathymetric</skos:altLabel>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#BathymetricSensor -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#BathymetricSensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
                <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#Depth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Bathymetric Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#BottomLockCapable -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#BottomLockCapable">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Vehicle"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasSensor"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#DVL"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">Bottom-Lock Capable Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#BottomLockSite -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#BottomLockSite">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Waypoint"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#onTerrain"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasSurface"/>
                                <owl:someValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#requiresNavigation"/>
                                        <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#BottomLockRequired"/>
                                    </owl:Restriction>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:label xml:lang="en">Bottom-Lock Site</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#BottomLocked -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#BottomLocked">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#AUV"/>
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#HasDVLLock"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
        <rdfs:label xml:lang="en">Bottom-Locked AUV</rdfs:label>
        <skos:definition xml:lang="en">AUV currently holding a DVL bottom-lock specifically -- a ship-relative USBL fix cannot track altitude over a scarp.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#CTDMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#CTDMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasActivity"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#CTDProfile"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">CTD Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission carrying out a CTD-profile activity (derived through hasActivity).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#CTDProfile -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#CTDProfile">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/madeBySensor"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#CTDSensor"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">CTD Profile</rdfs:label>
        <skos:altLabel xml:lang="en">CTD Profile</skos:altLabel>
        <skos:definition xml:lang="en">An observation made by a CTD sensor, profiling conductivity, temperature and depth through the water column.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#CTDSensor -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#CTDSensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
                <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#Conductivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
                <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#Depth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
                <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">CTD Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Camera -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Camera">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#OpticalSensor"/>
        <rdfs:label xml:lang="en">Camera</rdfs:label>
        <skos:altLabel xml:lang="en">CoraMo</skos:altLabel>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#CameraEquippedVehicle -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#CameraEquippedVehicle">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#DVL -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#DVL">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:label xml:lang="en">Doppler Velocity Log</rdfs:label>
        <skos:definition xml:lang="en">Bottom-lock sensor; locks only within dvl_range of the seabed.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#DataAcquisitionGoal -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#DataAcquisitionGoal">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Goal"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#QualificationGoal"/>
        <rdfs:label xml:lang="en">Data Acquisition Goal</rdfs:label>
        <skos:definition xml:lang="en">Acquire scientific data (e.g. seabed photo mosaics).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#DataObservationAndCollection -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#DataObservationAndCollection">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Data Observation and Collection</rdfs:label>
        <skos:altLabel xml:lang="en">Data Observation and Collection</skos:altLabel>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#DataSample -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#DataSample">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:label xml:lang="en">Data Sample</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#DataSampling -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#DataSampling">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasResult"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#DataSample"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Data Sampling</rdfs:label>
        <skos:altLabel xml:lang="en">Data Sampling</skos:altLabel>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#DataSamplingMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#DataSamplingMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasActivity"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#DataSampling"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Data Sampling Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission carrying out a data-sampling activity (derived through hasActivity).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Device -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Device">
        <rdfs:label xml:lang="en">Device</rdfs:label>
        <skos:definition xml:lang="en">Any component carried by a vehicle: a sensor or an actuator (Q7 vocabulary).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Echosounder -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Echosounder">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AcousticSensor"/>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#BathymetricSensor"/>
        <rdfs:label xml:lang="en">Echosounder</rdfs:label>
        <skos:altLabel xml:lang="en">Echosounder</skos:altLabel>
        <skos:definition xml:lang="en">Acoustic depth sounder (single- or split-beam); both a bathymetric and an acoustic sensor.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#FeasibleImagingMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#FeasibleImagingMission">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#FullySuccessfulMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#FullySuccessfulMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasTask"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Task"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasTask"/>
                        <owl:allValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasStatus"/>
                                <owl:hasValue>SUCCESSFUL</owl:hasValue>
                            </owl:Restriction>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Fully Successful Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission that has tasks and all of them succeeded.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#GPS -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#GPS">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:label xml:lang="en">GPS Receiver</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Goal -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Goal">
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Scenario"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">Goal</rdfs:label>
        <skos:definition xml:lang="en">The objective that a mission aims to achieve.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#HasDVLLock -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#HasDVLLock">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
        <rdfs:label xml:lang="en">AUV currently holding DVL bottom-lock</rdfs:label>
        <skos:definition xml:lang="en">FLUENT: the planner asserts/retracts this as the DVL locks or drops.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#HasUSBLFix -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#HasUSBLFix">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
        <rdfs:label xml:lang="en">AUV currently holding a USBL fix</rdfs:label>
        <skos:definition xml:lang="en">FLUENT: the planner asserts/retracts this as the USBL fix is (re)acquired or lost.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Hydrophone -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Hydrophone">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AcousticSensor"/>
        <rdfs:label xml:lang="en">Hydrophone</rdfs:label>
        <skos:altLabel xml:lang="en">Hydrophone</skos:altLabel>
        <skos:definition xml:lang="en">Passive acoustic sensor: listens to underwater sound.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#ImagingMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#ImagingMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasAction"/>
                        <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#Act_TakePhoto"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Imaging Mission</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#LongTask -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#LongTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Task"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasDuration"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.0</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <rdfs:label xml:lang="en">Long Task</rdfs:label>
        <skos:definition xml:lang="en">A task of 6 h or more -- about one hover-AUV battery endurance (Rep55 Sec. 5.2.1, ~8 h).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#MBES -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#MBES">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#BathymetricSensor"/>
        <rdfs:label xml:lang="en">Multibeam Echosounder</rdfs:label>
        <skos:altLabel xml:lang="en">Multibeam</skos:altLabel>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Manipulator -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Manipulator">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <rdfs:label xml:lang="en">Manipulator Arm</rdfs:label>
        <skos:altLabel xml:lang="en">ORION</skos:altLabel>
        <skos:altLabel xml:lang="en">RIGMASTER</skos:altLabel>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Mission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Mission">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/ssn/Deployment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasGoal"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasInitialCondition"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Scenario"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasTask"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesVehicle"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Scenario"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">Mission</rdfs:label>
        <skos:definition xml:lang="en">A goal-directed campaign within a research cruise, grouping the tasks that achieve its goal from one or more platforms, starting from a given initial condition.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#MultiPlatformMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#MultiPlatformMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesVehicle"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#AUV"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesVehicle"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Submersible"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Multi-Platform Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission integrating vehicles of two different classes (e.g. the JAGO + ANTON mutual dive).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#NavFixCapable -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#NavFixCapable">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Vehicle"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasSensor"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#DVL"/>
                                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#USBL"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">Navigation-Fix Capable Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#NavFixSite -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#NavFixSite">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Waypoint"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#onTerrain"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasSurface"/>
                                <owl:someValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#requiresNavigation"/>
                                        <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#NavFixRequired"/>
                                    </owl:Restriction>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:label xml:lang="en">Navigation-Fix Site</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#NavFixed -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#NavFixed">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#AUV"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://oru.se/marinellm/survey#HasDVLLock"/>
                            <rdf:Description rdf:about="http://oru.se/marinellm/survey#HasUSBLFix"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
        <rdfs:label xml:lang="en">Navigation-Fixed AUV</rdfs:label>
        <skos:definition xml:lang="en">AUV currently holding EITHER a DVL bottom-lock or a USBL fix -- either suffices for a nav-fix site.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#NavigationRequirement -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#NavigationRequirement">
        <rdfs:label xml:lang="en">Navigation Requirement</rdfs:label>
        <skos:definition xml:lang="en">The navigation capability a surface demands of a vehicle crossing it.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#OpticalMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#OpticalMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesDevice"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#OpticalSensor"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Optical Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission using an optical sensor (camera) on any of its vehicles (derived through usesDevice).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#OpticalSensor -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#OpticalSensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:label xml:lang="en">Optical Sensor</rdfs:label>
        <skos:definition xml:lang="en">A sensor imaging with light (camera, hyperspectral, ...).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Parasound -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Parasound">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Sonar"/>
        <rdfs:label xml:lang="en">Sub-bottom Profiler</rdfs:label>
        <skos:altLabel xml:lang="en">Parasound</skos:altLabel>
        <skos:altLabel xml:lang="en">Sub-bottom Profiler</skos:altLabel>
        <skos:definition xml:lang="en">Sediment-penetrating acoustic profiler (a sonar); PARASOUND is the GEOMAR instrument.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#PartiallyFailedMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#PartiallyFailedMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasTask"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasStatus"/>
                                <owl:hasValue>FAILED</owl:hasValue>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Partially Failed Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission with at least one failed task.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#PerformableTraversal -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#PerformableTraversal">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Traversal"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasDestination"/>
                                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#BottomLockSite"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasVehicle"/>
                                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#BottomLocked"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasDestination"/>
                                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#NavFixSite"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasVehicle"/>
                                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#NavFixed"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasDestination"/>
                                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#UnconstrainedSite"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Traversal"/>
        <rdfs:label xml:lang="en">Performable Traversal</rdfs:label>
        <skos:definition xml:lang="en">A traversal the vehicle can actually perform: the destination is unconstrained, OR needs a nav-fix and the vehicle has one, OR needs bottom-lock and the vehicle has it. The whole of can_perform as one OWL concept (README Sec. 7.2).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#PlannableMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#PlannableMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasAction"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Action"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Plannable Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission whose tasks are grounded in PDDL action schemas, so a problem file can be generated.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#QualificationGoal -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#QualificationGoal">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Goal"/>
        <rdfs:label xml:lang="en">Qualification Goal</rdfs:label>
        <skos:definition xml:lang="en">Qualify / commission equipment or train crew.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#SSS -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#SSS">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Sonar"/>
        <rdfs:label xml:lang="en">Side-Scan Sonar</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Scenario -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Scenario">
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Task"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">Scenario</rdfs:label>
        <skos:definition xml:lang="en">The initial condition of a mission: platform and equipment state and the environment at mission start.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#ScienceMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#ScienceMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasGoal"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#DataAcquisitionGoal"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Science Mission</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Ship -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Ship">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">Ship</rdfs:label>
        <skos:altLabel xml:lang="en">Research Vessel</skos:altLabel>
        <skos:definition xml:lang="en">The surface mother ship from which vehicles are deployed and missions are run, e.g. RV ALKOR.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#SinglePlatformMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#SinglePlatformMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesVehicle"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Single-Platform Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission using exactly one vehicle.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Sonar -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Sonar">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AcousticSensor"/>
        <rdfs:label xml:lang="en">Sonar</rdfs:label>
        <skos:altLabel xml:lang="en">Sonar</skos:altLabel>
        <skos:definition xml:lang="en">Active acoustic sensor: images or ranges by emitting sound and timing echoes.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Submersible -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Submersible">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Transponder"/>
        <rdfs:label xml:lang="en">Manned Submersible</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#SubmersibleMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#SubmersibleMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesVehicle"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Submersible"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Submersible Mission</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Surface -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Surface">
        <rdfs:label xml:lang="en">Surface</rdfs:label>
        <skos:definition xml:lang="en">The ground class of a terrain area.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#SurveyMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#SurveyMission">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Survey Mission</rdfs:label>
        <skos:definition xml:lang="en">A mission that belongs to a Survey-and-Navigation campaign (the combined Sec. 5 category; navigation folded in). Derived through missionOf.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Task -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Task">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#taskOf"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Mission"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">Task</rdfs:label>
        <skos:definition xml:lang="en">An operation carried out as part of a mission (e.g. a dive, a deployment, a test).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#TerrainArea -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#TerrainArea">
        <rdfs:label xml:lang="en">Terrain Area</rdfs:label>
        <skos:definition xml:lang="en">One mappable ground unit grouping a set of waypoints (e.g. the Comino ridge, the Qawra shelf).</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Thruster -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Thruster">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <rdfs:label xml:lang="en">Thruster</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Transponder -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Transponder">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <rdfs:label xml:lang="en">Seabed Transponder</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#TransponderMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#TransponderMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#usesVehicle"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Transponder"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Transponder Mission</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Traversal -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Traversal">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasDestination"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasVehicle"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#AUV"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Traversal</rdfs:label>
        <skos:definition xml:lang="en">A reified move: an AUV going to a destination waypoint.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#TrialMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#TrialMission">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Mission"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasGoal"/>
                        <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#QualificationGoal"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Trial Mission</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#USBL -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#USBL">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:label xml:lang="en">Ultra-Short BaseLine positioning</rdfs:label>
        <skos:definition xml:lang="en">Acoustic position fix from the surface vessel; available anywhere in the water column.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#UnconstrainedSite -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#UnconstrainedSite">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://oru.se/marinellm/survey#Waypoint"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#onTerrain"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#hasSurface"/>
                                <owl:someValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#requiresNavigation"/>
                                        <owl:hasValue rdf:resource="http://oru.se/marinellm/survey#NoFixRequired"/>
                                    </owl:Restriction>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
        <rdfs:label xml:lang="en">Unconstrained Site</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Vehicle -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Vehicle">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/ssn/System"/>
        <rdfs:label xml:lang="en">Vehicle</rdfs:label>
        <skos:definition xml:lang="en">A mobile or moored underwater platform used in a mission.</skos:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Waypoint -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Waypoint">
        <rdfs:label xml:lang="en">Waypoint</rdfs:label>
        <skos:definition xml:lang="en">A dive site: latitude, longitude, seabed depth.</skos:definition>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://oru.se/marinellm/survey#ANTON -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#ANTON">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Vehicle"/>
        <hasSensor rdf:resource="http://oru.se/marinellm/survey#CoraMo_MK_II"/>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#Act_AcquireDVLLock -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#Act_AcquireDVLLock">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <rdfs:comment xml:lang="en">PDDL &apos;acquire_dvl_lock&apos; - DVL bottom-lock, achievable only once the vehicle&apos;s altitude above the seabed is within dvl_range (depth-dependent) (domain_55.pddl).</rdfs:comment>
        <rdfs:label xml:lang="en">acquire_dvl_lock</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#Act_DeepDive -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#Act_DeepDive">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <rdfs:comment xml:lang="en">PDDL &apos;deep_dive&apos; - USBL-aided descent through the water column to the site&apos;s seabed depth (no DVL bottom-lock yet) (domain_55.pddl).</rdfs:comment>
        <rdfs:label xml:lang="en">deep_dive</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#Act_EstablishUSBLFix -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#Act_EstablishUSBLFix">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <rdfs:comment xml:lang="en">PDDL &apos;establish_usbl_fix&apos; - ship-relative acoustic position fix from the surface vessel&apos;s USBL, available anywhere in the water column (domain_55.pddl).</rdfs:comment>
        <rdfs:label xml:lang="en">establish_usbl_fix</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#Act_Move -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#Act_Move">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <rdfs:comment xml:lang="en">PDDL durative-action &apos;move&apos; - transit between connected waypoints; the destination&apos;s terrain class (flat/rocky) is read from the ontology, and rocky ground requires a live DVL bottom-lock or USBL fix (domain_55.pddl).</rdfs:comment>
        <rdfs:label xml:lang="en">move</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#Act_TakePhoto -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#Act_TakePhoto">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#Action"/>
        <rdfs:comment xml:lang="en">PDDL &apos;take_photo&apos; - CoraMo Mk II imaging survey flown at the seabed under DVL bottom-lock, producing one photo survey per site (domain_55.pddl).</rdfs:comment>
        <rdfs:label xml:lang="en">take_photo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#BottomLockRequired -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#BottomLockRequired">
        <rdf:type rdf:resource="http://oru.se/marinellm/survey#NavigationRequirement"/>
        <rdfs:label xml:lang="en">DVL bottom-lock required</rdfs:label>
        <skos:definition xml:lang="en">Steep ground: altitude must be tracked continuously, so a USBL ship-fix is NOT sufficient. DVL bottom-lock specifically.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#Conductivity -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#Conductivity">
