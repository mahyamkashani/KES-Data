    <rdfs:label xml:lang="en">Survey Mission</rdfs:label>
    <skos:definition xml:lang="en">A mission that belongs to a Survey-and-Navigation campaign (the combined Sec. 5 category; navigation folded in). Derived through missionOf.</skos:definition>
  </rdf:Description>
