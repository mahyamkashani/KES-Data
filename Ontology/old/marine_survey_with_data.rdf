        <rdfs:label xml:lang="en">CoraMo MK II</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://oru.se/marinellm/survey#Depth -->

    <owl:NamedIndividual rdf:about="http://oru.se/marinellm/survey#Depth">
