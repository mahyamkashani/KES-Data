    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Traversal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab165"/>
    <rdfs:subClassOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab166"/>
    <rdfs:label xml:lang="en">Traversal</rdfs:label>
    <skos:definition xml:lang="en">A reified move: an AUV going to a destination waypoint.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#AUVMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
