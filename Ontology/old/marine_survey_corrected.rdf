>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:propertyChainAxiom rdf:nodeID="N46983960585c4c408579ef61dbf13806"/>
    <rdfs:label xml:lang="en">has action</rdfs:label>
    <skos:definition xml:lang="en">Derived: the primitive planner actions of a mission, via its tasks.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#ScienceMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N271935f6540945bc91c51dc93f06b0bb"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdfs:label xml:lang="en">Science Mission</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbfb62a6d699f4cf783502be785c293b7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="N13590816e81d457287e0b0a4d9d729c8"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#realisedByAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Action"/>
    <rdfs:label xml:lang="en">realised by action</rdfs:label>
    <skos:definition xml:lang="en">Links a mission Task to the primitive planner Action(s) that carry it out (PDDL domain al533_auv_survey, domain_55.pddl).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf25dac0f8326459587006d6397b27eb1">
    <rdf:first rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
    <rdf:rest rdf:nodeID="Nd7fbed95c1b54aa4b94e72c826134901"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#SurveyNavigation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/ssn/Deployment"/>
    <rdfs:subClassOf rdf:nodeID="Ne718a6e3cebd469593d5b82ac9d91f05"/>
    <rdfs:label xml:lang="en">Survey and Navigation</rdfs:label>
    <skos:altLabel xml:lang="en">Survey and Navigation</skos:altLabel>
    <skos:definition xml:lang="en">A survey campaign and its navigation, grouping the observation and sampling activities carried out from a platform. A cruise report typically contains several missions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N16a7b0a6f5694bd281070a4b0de00a82">
    <rdf:first rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdf:rest rdf:nodeID="N666e9ebfe52b4c8f84d2cda1a08e2747"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#inMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <owl:propertyChainAxiom rdf:nodeID="N9379db2806d94cce8b3d3ce86ba44ba2"/>
    <rdfs:label xml:lang="en">in mission</rdfs:label>
    <skos:definition xml:lang="en">Derived: the mission an observation or sampling activity belongs to, via the task it executes (usedProcedure o taskOf).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasScenarioTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Scenario"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Task"/>
    <owl:propertyChainAxiom rdf:nodeID="Ncd41f7bef1874a1c978aa41e1dbe7e44"/>
    <rdfs:label xml:lang="en">has scenario task</rdfs:label>
    <skos:definition xml:lang="en">Derived: the tasks carried out under this scenario -- the tasks of the (single) mission this scenario initiates (initialConditionOf o hasTask).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#NavFixRequired">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#NavigationRequirement"/>
    <rdfs:label xml:lang="en">navigation fix required</rdfs:label>
    <skos:definition xml:lang="en">Hard/irregular ground: needs a LIVE fix -- DVL bottom-lock OR USBL. Either satisfies it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0797a679e199478087f4a5a2c83ae1da">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
    <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Task"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#CTDProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nbefbbcbeec354a9aa7424730757e1d78"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:subClassOf rdf:nodeID="N6d4c89d8f40641bca6b6534a7d4ff60e"/>
    <rdfs:label xml:lang="en">CTD Profile</rdfs:label>
    <skos:altLabel xml:lang="en">CTD Profile</skos:altLabel>
    <skos:definition xml:lang="en">An observation made by a CTD sensor, profiling conductivity, temperature and depth through the water column.</skos:definition>
  </rdf:Description>
