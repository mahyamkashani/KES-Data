        <rdfs:label xml:lang="en">Vehicle</rdfs:label>
        <core:definition xml:lang="en">A mobile or moored underwater platform used in a mission.</core:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Waypoint -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Waypoint">
        <rdfs:label>WayPoint</rdfs:label>
    </owl:Class>
    


