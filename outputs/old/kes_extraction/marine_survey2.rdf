    <owl:intersectionOf rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab100"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasGoal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Mission"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Goal"/>
    <rdfs:label xml:lang="en">has goal</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab132">
    <rdf:first rdf:nodeID="n2122f313d70942ca8f67c96af656b06ab128"/>
