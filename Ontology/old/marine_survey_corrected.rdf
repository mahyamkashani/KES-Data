  <rdf:Description rdf:about="http://oru.se/marinellm/survey#steep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
    <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#BottomLockRequired"/>
    <rdfs:comment xml:lang="en">Slope / scarp. Altitude changes fast under the vehicle, so a ship-relative USBL fix is not enough -- DVL bottom-lock is mandatory.</rdfs:comment>
    <rdfs:label xml:lang="en">steep</rdfs:label>
  </rdf:Description>
