  <rdf:Description rdf:about="http://oru.se/marinellm/survey#rocky">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
    <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#NavFixRequired"/>
