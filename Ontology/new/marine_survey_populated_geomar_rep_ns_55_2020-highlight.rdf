        <rdfs:label>Submersible Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#SurveyMission -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#SurveyMission">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label xml:lang="en">Survey Mission</rdfs:label>
        <core:definition xml:lang="en">A mission that belongs to a Survey-and-Navigation campaign (the combined Sec. 5 category; navigation folded in). Derived through missionOf.</core:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Survey_and_Navigation -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Survey_and_Navigation">
        <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#Mission"/>
        <rdfs:label>Survey and Navigation</rdfs:label>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Task -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Task">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://oru.se/marinellm/survey#taskOf"/>
                <owl:someValuesFrom rdf:resource="http://oru.se/marinellm/survey#Mission"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Task</rdfs:label>
        <core:definition xml:lang="en">An operation carried out as part of a mission (e.g. a dive, a deployment, a test).</core:definition>
    </owl:Class>
    


    <!-- http://oru.se/marinellm/survey#Terrain -->

    <owl:Class rdf:about="http://oru.se/marinellm/survey#Terrain">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:label>Terrain</rdfs:label>
    </owl:Class>
    


