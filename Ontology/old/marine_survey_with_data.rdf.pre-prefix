  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#HasDVLLock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AUV"/>
    <rdfs:label xml:lang="en">AUV currently holding DVL bottom-lock</rdfs:label>
    <skos:definition xml:lang="en">FLUENT: the planner asserts/retracts this as the DVL locks or drops.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#seabedDepth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">seabed depth</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N74612275bfb64652b4f81bbfa287a956">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="N79c7e2b46f8a4baa96c2829cdce95362"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#steep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://oru.se/marinellm/survey#Surface"/>
    <requiresNavigation rdf:resource="http://oru.se/marinellm/survey#BottomLockRequired"/>
    <rdfs:comment xml:lang="en">Slope / scarp. Altitude changes fast under the vehicle, so a ship-relative USBL fix is not enough -- DVL bottom-lock is mandatory.</rdfs:comment>
    <rdfs:label xml:lang="en">steep</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#CTDSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:subClassOf rdf:nodeID="N484c86fef26644caa6e04eb2f2788210"/>
    <rdfs:subClassOf rdf:nodeID="Nb1ab3182cff1485da2dfd4b88c2860e1"/>
    <rdfs:subClassOf rdf:nodeID="N99076449dd72490f9abc6c97f5f01e29"/>
    <rdfs:label xml:lang="en">CTD Sensor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasScenarioTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Scenario"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#Task"/>
    <owl:propertyChainAxiom rdf:nodeID="N3fdcdc56a4474415bc3ca38dbfd13b82"/>
    <rdfs:label xml:lang="en">has scenario task</rdfs:label>
    <skos:definition xml:lang="en">Derived: the tasks carried out under this scenario -- the tasks of the (single) mission this scenario initiates (initialConditionOf o hasTask).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#onTerrain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Waypoint"/>
    <rdfs:range rdf:resource="http://oru.se/marinellm/survey#TerrainArea"/>
    <rdfs:label xml:lang="en">on terrain</rdfs:label>
    <skos:definition xml:lang="en">The terrain AREA a waypoint falls inside. Terrain is a mappable area covering a SET of waypoints, not a per-waypoint tag.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N28a850b95e5d450fa3cc06d138e9211c">
    <rdf:first rdf:nodeID="N7546b89ee4c244779bb506ca620b8d47"/>
    <rdf:rest rdf:nodeID="Nb7ec5a825b1b4fb88b81c596c2291aff"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Sonar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AcousticSensor"/>
    <rdfs:label xml:lang="en">Sonar</rdfs:label>
    <skos:altLabel xml:lang="en">Sonar</skos:altLabel>
    <skos:definition xml:lang="en">Active acoustic sensor: images or ranges by emitting sound and timing echoes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#Hydrophone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://oru.se/marinellm/survey#AcousticSensor"/>
    <rdfs:label xml:lang="en">Hydrophone</rdfs:label>
    <skos:altLabel xml:lang="en">Hydrophone</skos:altLabel>
    <skos:definition xml:lang="en">Passive acoustic sensor: listens to underwater sound.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://oru.se/marinellm/survey#hasStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://oru.se/marinellm/survey#Task"/>
    <rdfs:range rdf:nodeID="N309455ea37424b37abd6a0ccfd2a5b3d"/>
    <rdfs:label xml:lang="en">has status</rdfs:label>
    <skos:definition xml:lang="en">The outcome of a task: exactly one of SUCCESSFUL / PartialSUCCESSFUL / FAILED (closed datatype enumeration). Functional: one status per task.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N41fee2ce5a674a4ca49e5efd51d2c868">
